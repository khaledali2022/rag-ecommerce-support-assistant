# Copy this file to .env and adjust as needed.

APP_NAME=RAG E-Commerce Support Assistant
ENV=development

# Must match the URL your Streamlit frontend runs on
FRONTEND_ORIGIN=http://localhost:8501

# Vector store (produced by notebooks/rag_pipeline.ipynb, then copied here)
VECTOR_STORE_DIR=data/vector_store
COLLECTION_NAME=ecommerce_support
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=4

# Local Ollama LLM
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
